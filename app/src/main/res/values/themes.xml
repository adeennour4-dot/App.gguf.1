<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Material 3 -->
    <!-- Uses explicit color definitions instead of Material 3 attributes -->
    <style name="Theme.GGUFZeroCopyV7" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:NavigationBarColor">@color/bg_deep</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.GGUFZeroCopyV7.Splash" parent="Theme.GGUFZeroCopyV7">
        <item name="android:windowBackground">@drawable/ic_launcher_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>
</resources>